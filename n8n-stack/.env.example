# ============================================================
# n8n-stack environment
# Copy this file to .env and fill in the values,
# or simply run:  bash scripts/generate-secrets.sh
# ============================================================

# Your base domain. Services will live at:
#   n8n.<BASE_DOMAIN>, qdrant.<BASE_DOMAIN>, uptime.<BASE_DOMAIN>, supabase.<BASE_DOMAIN>
# The domain must be managed by Cloudflare (free plan is fine).
BASE_DOMAIN=example.com

# Cloudflare API token for Let's Encrypt certificates (DNS-01 challenge).
# Create it at: Cloudflare -> My Profile -> API Tokens -> Create Token
# Permissions: Zone -> DNS -> Edit, scoped to your zone only.
CF_DNS_API_TOKEN=CHANGE_ME

# API key protecting your Qdrant vector database.
# Generate with:  openssl rand -hex 32
QDRANT_API_KEY=CHANGE_ME

# Timezone for n8n schedules (Schedule Trigger uses this).
# List: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
GENERIC_TIMEZONE=Europe/Kyiv
