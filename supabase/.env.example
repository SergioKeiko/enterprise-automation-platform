# ============================================================
# Supabase environment
# Copy this file to .env and fill in the values,
# or simply run:  bash scripts/generate-secrets.sh
# (the script generates every placeholder value for you)
# ============================================================

############
# Domain
############

# Same base domain as in n8n-stack/.env
BASE_DOMAIN=example.com

############
# Secrets — every placeholder below is generated by scripts/generate-secrets.sh
############

POSTGRES_PASSWORD=CHANGE_ME
JWT_SECRET=CHANGE_ME
# ANON_KEY and SERVICE_ROLE_KEY are JWTs signed with JWT_SECRET —
# do not invent them by hand, generate them with the script.
ANON_KEY=CHANGE_ME
SERVICE_ROLE_KEY=CHANGE_ME
DASHBOARD_USERNAME=supabase
DASHBOARD_PASSWORD=CHANGE_ME
SECRET_KEY_BASE=CHANGE_ME
VAULT_ENC_KEY=CHANGE_ME

############
# Database
############

POSTGRES_HOST=db
POSTGRES_DB=postgres
POSTGRES_PORT=5432
# default user is postgres

############
# Supavisor — database pooler (external apps connect to port 6543)
############
POOLER_PROXY_PORT_TRANSACTION=6543
POOLER_DEFAULT_POOL_SIZE=20
POOLER_MAX_CLIENT_CONN=100
POOLER_TENANT_ID=main

############
# Kong API gateway
############

KONG_HTTP_PORT=8000
KONG_HTTPS_PORT=8443

############
# PostgREST
############

PGRST_DB_SCHEMAS=public,storage,graphql_public

############
# Auth (GoTrue)
############

## General — filled with your domain by generate-secrets.sh
SITE_URL=https://supabase.example.com
ADDITIONAL_REDIRECT_URLS=
JWT_EXPIRY=3600
DISABLE_SIGNUP=false
API_EXTERNAL_URL=https://supabase.example.com

## Mailer Config
MAILER_URLPATHS_CONFIRMATION="/auth/v1/verify"
MAILER_URLPATHS_INVITE="/auth/v1/verify"
MAILER_URLPATHS_RECOVERY="/auth/v1/verify"
MAILER_URLPATHS_EMAIL_CHANGE="/auth/v1/verify"

## Email auth — plug in your own SMTP provider to send real emails
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=false
SMTP_ADMIN_EMAIL=admin@example.com
SMTP_HOST=supabase-mail
SMTP_PORT=2500
SMTP_USER=fake_mail_user
SMTP_PASS=fake_mail_password
SMTP_SENDER_NAME=fake_sender
ENABLE_ANONYMOUS_USERS=false

## Phone auth
ENABLE_PHONE_SIGNUP=true
ENABLE_PHONE_AUTOCONFIRM=true

############
# Studio dashboard
############

STUDIO_DEFAULT_ORGANIZATION=Default Organization
STUDIO_DEFAULT_PROJECT=Default Project

STUDIO_PORT=3000
# Public URL of your Supabase API (through Traefik)
SUPABASE_PUBLIC_URL=https://supabase.example.com

# Enable webp support
IMGPROXY_ENABLE_WEBP_DETECTION=true

# Optional: OpenAI API key enables the SQL Editor Assistant in Studio
OPENAI_API_KEY=

############
# Edge Functions
############
FUNCTIONS_VERIFY_JWT=false

############
# Analytics (Logflare)
############

# these cannot be the same value
LOGFLARE_PUBLIC_ACCESS_TOKEN=CHANGE_ME
LOGFLARE_PRIVATE_ACCESS_TOKEN=CHANGE_ME

# Docker socket location - this value will differ depending on your OS
DOCKER_SOCKET_LOCATION=/var/run/docker.sock

# Google Cloud Project details (only needed for BigQuery analytics backend)
GOOGLE_PROJECT_ID=GOOGLE_PROJECT_ID
GOOGLE_PROJECT_NUMBER=GOOGLE_PROJECT_NUMBER
